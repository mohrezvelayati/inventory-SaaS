DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql://inventory:inventory@localhost:5433/inventory_saas
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
APP_ENVIRONMENT=development
APP_RELEASE=local
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SMS_BACKEND=disabled
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=inventory-password-reset
PASSWORD_RESET_OTP_TTL_SECONDS=300
PASSWORD_RESET_MAX_ATTEMPTS=5
DEMO_MODE_ENABLED=false
SEED_DEMO_ON_START=false
CACHE_URL=redis://localhost:6380/1
DASHBOARD_CACHE_TTL_SECONDS=60